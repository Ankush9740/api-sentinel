# Neon PostgreSQL (server-only)
# Use Neon's pooled connection URL for application queries and its direct URL
# for Prisma CLI migrations. PostgreSQL URLs must include sslmode=require.
DATABASE_URL=""
DIRECT_URL=""

# Auth.js OAuth providers (server-only)
# Generate AUTH_SECRET with: npx auth secret
# Canonical application origin, for example http://localhost:3000 locally.
AUTH_URL=""
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32 random bytes encoded as canonical Base64 (44 characters, including padding).
# Generate locally; never reuse AUTH_SECRET and never commit the result.
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# PostgreSQL connection string (Phase 1)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js server secret and GitHub OAuth credentials (Phase 1)
AUTH_SECRET="replace-with-a-cryptographically-random-secret"
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# Base URL used for absolute application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32-byte application encryption key, encoded as required by the Phase 7 implementation
ENCRYPTION_KEY="replace-with-a-cryptographically-random-key"

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum AssertionType {
  STATUS_CODE
  RESPONSE_TIME
  JSON_PATH
  HEADER
}

enum AssertionOperator {
  EQUALS
  NOT_EQUALS
  LESS_THAN
  EXISTS
  DOES_NOT_EXIST
  CONTAINS
  GREATER_THAN
  BETWEEN
}

enum ExecutionStatus {
  SUCCESS
  HTTP_RESPONSE
  TIMEOUT
  DNS_ERROR
  CONNECTION_ERROR
  TLS_ERROR
  INVALID_REQUEST
  RESPONSE_TOO_LARGE
  BLOCKED_TARGET
  INTERNAL_ERROR
}

enum RequestHeaderValueKind {
  PLAIN
  ENCRYPTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  collections Collection[]
  requestRuns RequestRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoints Endpoint[]

  @@index([userId, updatedAt])
}

model Endpoint {
  id           String     @id @default(cuid())
  collectionId String
  name         String
  method       HttpMethod
  url          String
  body         String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  collection      Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  requestHeaders  RequestHeader[]
  queryParameters QueryParameter[]
  assertions      Assertion[]
  requestRuns     RequestRun[]

  @@index([collectionId, updatedAt])
}

model RequestHeader {
  id         String                 @id @default(cuid())
  endpointId String
  key        String
  value      String                 @db.Text
  valueKind  RequestHeaderValueKind @default(PLAIN)
  enabled    Boolean                @default(true)
  sensitive  Boolean                @default(false)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
}

model QueryParameter {
  id         String   @id @default(cuid())
  endpointId String
  key        String
  value      String   @db.Text
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
}

model Assertion {
  id            String            @id @default(cuid())
  endpointId    String
  type          AssertionType
  operator      AssertionOperator
  target        String?
  expectedValue String?           @db.Text
  enabled       Boolean           @default(true)
  position      Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  endpoint Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  results  AssertionResult[]

  @@index([endpointId, position])
}

model RequestRun {
  id                    String          @id @default(cuid())
  endpointId            String?
  userId                String
  endpointName          String?
  method                HttpMethod
  url                   String
  finalUrl              String?
  statusCode            Int?
  statusText            String?
  durationMs            Int?
  responseSizeBytes     BigInt?
  responseContentType   String?
  responseBodyKind      String?
  responseBody          String?         @db.Text
  responseBodyTruncated Boolean         @default(false)
  redirectCount         Int?
  executionStatus       ExecutionStatus
  errorCode             String?
  errorMessage          String?         @db.Text
  createdAt             DateTime        @default(now())

  endpoint         Endpoint?         @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assertionResults AssertionResult[]

  @@index([userId, createdAt])
  @@index([endpointId, createdAt])
}

model AssertionResult {
  id           String             @id @default(cuid())
  requestRunId String
  assertionId  String?
  type         AssertionType
  operator     AssertionOperator?
  target       String?
  label        String?            @db.Text
  position     Int                @default(0)
  passed       Boolean
  expected     String?            @db.Text
  actual       String?            @db.Text
  message      String?            @db.Text
  createdAt    DateTime           @default(now())

  requestRun RequestRun @relation(fields: [requestRunId], references: [id], onDelete: Cascade)
  assertion  Assertion? @relation(fields: [assertionId], references: [id], onDelete: SetNull)

  @@index([requestRunId, position])
  @@index([assertionId])
}

# Neon PostgreSQL (server-only)
# Use Neon's pooled connection URL for application queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Use Neon's direct connection URL for Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Auth.js and GitHub OAuth (server-only)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET="replace-with-a-cryptographically-random-secret-of-at-least-32-characters"
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# 32-byte application encryption key, encoded as required by the Phase 7 implementation
ENCRYPTION_KEY="replace-with-a-cryptographically-random-key"
